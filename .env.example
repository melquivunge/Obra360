APP_NAME=Obra360
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=obra360
DB_ROOT_PASSWORD=
DB_USERNAME=obra360_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REVERB_ALLOWED_ORIGINS=http://localhost:8000

# Content Security Policy — ver docs/production-readiness.md.
#
# Fora de produção a política é imposta por omissão, para que uma violação nova
# apareça em desenvolvimento, onde é barata. Em produção começa em modo de
# relato: o browser comunica as violações e não bloqueia nada. Depois de
# observar os relatórios em storage/logs, ponha CSP_REPORT_ONLY=false para
# passar a impor.
# CSP_REPORT_ONLY=false
# CSP_ENABLED=false            # travão de emergência: remove o cabeçalho
# CSP_REPORT_URI=              # vazio desliga a recolha de relatórios
# CSP_EXTRA_CONNECT_SRC=       # origens adicionais, separadas por vírgula

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# PWA Web Push (VAPID) — gerar com: composer require minishlink/web-push && php artisan tinker
# >>> [Minishlink\WebPush\VAPID::createVapidKeys()['publicKey'], Minishlink\WebPush\VAPID::createVapidKeys()['privateKey']]
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@obra360.com
